{
  "name": "slackie",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @slackie/web dev",
    "prebuild": "npx -y @proappstore/cli@latest check",
    "build": "pnpm --filter @slackie/web build",
    "preview": "pnpm --filter @slackie/web preview",
    "lint": "echo 'Lint configured per app; extend lintstagedrc.json with eslint/prettier'",
    "typecheck": "pnpm --filter @slackie/web exec tsc -b",
    "test": "pnpm --filter @slackie/web exec tsc -b && node --no-warnings qa/actions.mjs && node --test qa/attachments.mjs && node qa/contrast.mjs",
    "test:browser": "playwright test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.12"
  }
}
